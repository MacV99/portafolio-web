---
// src/components/Starfield.astro
---

<div class="starfield" aria-hidden="true"></div>

<style>
  @keyframes star-flicker {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }

  .starfield {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .starfield :global(.star) {
    position: absolute;
    background: white;
    border-radius: 50%;
    animation: star-flicker var(--duration) infinite ease-in-out;
  }

  /* Sin parpadeo para quien pide menos animaciones en su dispositivo */
  @media (prefers-reduced-motion: reduce) {
    .starfield :global(.star) {
      animation: none;
      opacity: 0.6;
    }
  }
</style>

<script>
  //@ts-nocheck
  function buildStarfield() {
    const starfield = document.querySelector(".starfield");
    if (!starfield) return;

    // Evita duplicar estrellas al re-ejecutar (View Transitions)
    if (starfield.childElementCount > 0) return;

    // Crear 100 estrellas
    for (let i = 0; i < 100; i++) {
      const star = document.createElement("div");
      star.className = "star";

      // Tamaño aleatorio entre 0.5px y 2.5px
      const size = Math.random() * 2 + 0.5;
      star.style.width = size + "px";
      star.style.height = size + "px";

      // Posición aleatoria
      star.style.left = Math.random() * 100 + "%";
      star.style.top = Math.random() * 100 + "%";

      // Duración de animación aleatoria
      star.style.setProperty("--duration", Math.random() * 3.5 + 2.5 + "s");

      starfield.appendChild(star);
    }
  }

  // Corre ya (los <script> de Astro son deferred: el DOM ya está listo)
  buildStarfield();
  // Y de nuevo si algún día usas el router de Astro (<ClientRouter/>)
  document.addEventListener("astro:page-load", buildStarfield);
</script>
