---
// Fuentes self-hosted (sin render-block del CDN de Google)
import "@fontsource-variable/montserrat";
import "@fontsource/orbitron/400.css";
import "@fontsource/orbitron/500.css";
import "@fontsource/orbitron/700.css";
import "@fontsource/orbitron/900.css";

// Iconos self-hosted (sin render-block del CDN de jsdelivr)
import "bootstrap-icons/font/bootstrap-icons.css";

import "../styles/global.css";
import Starfield from "../components/Starfield.astro";
import { defaultLang, localizedPath, type Lang } from "../i18n/ui";

interface Props {
  title: string;
  description?: string;
  image?: string;
  lang?: Lang;
}

const {
  title,
  description = "Miguel Angel Cuellar Velandia (MacV) — Software Engineer specialized in Astro, Python, JavaScript and web development.",
  image = "/img/macv.jpg",
  lang = defaultLang,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = new URL(image, Astro.site ?? Astro.url);

const site = Astro.site ?? Astro.url;
const esPath = localizedPath("/", "es");
const enPath = localizedPath("/", "en");
const esHref = new URL(esPath, site).href;
const enHref = new URL(enPath, site).href;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- hreflang -->
    <link rel="alternate" hreflang="es" href={esHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={esHref} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body>
    <Starfield />
    <nav class="lang-switch" aria-label={lang === "es" ? "Idioma" : "Language"}>
      <i class="bi bi-translate lang-switch__icon"></i>
      <div class="lang-switch__track" data-active={lang}>
        <span class="lang-switch__thumb" aria-hidden="true"></span>
        <a
          class="lang-switch__opt"
          href={esPath}
          hreflang="es"
          aria-current={lang === "es" ? "true" : undefined}>ES</a
        >
        <a
          class="lang-switch__opt"
          href={enPath}
          hreflang="en"
          aria-current={lang === "en" ? "true" : undefined}>EN</a
        >
      </div>
    </nav>
    <main>
      <slot />
    </main>
  </body>

  <style>
    @view-transition {
      navigation: auto; /* enabled! */
    }

    .lang-switch {
      position: fixed;
      top: 18px;
      right: 18px;
      z-index: 100;
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 5px 7px 5px 12px;
      border-radius: 100px;
      background-color: #ffffff08;
      border: solid 1px var(--clr-border);
      backdrop-filter: var(--blur);
      box-shadow: 0 6px 24px #00000040;
      transition:
        border-color var(--transition-md),
        box-shadow var(--transition-md);
    }

    .lang-switch__icon {
      font-size: 15px;
      color: #ffffffb0;
      transition: color var(--transition-md);
    }

    /* Riel del segmentado */
    .lang-switch__track {
      position: relative;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2px;
      padding: 3px;
      border-radius: 100px;
      background-color: #00000033;
      isolation: isolate;
    }

    /* Indicador deslizante */
    .lang-switch__thumb {
      position: absolute;
      z-index: -1;
      top: 3px;
      bottom: 3px;
      left: 3px;
      width: calc(50% - 3px);
      border-radius: 100px;
      background: var(--clr-accent);
      box-shadow: 0 0 14px -2px var(--clr-accent);
      transition: transform 0.32s cubic-bezier(0.34, 1.4, 0.64, 1);
    }

    .lang-switch__track[data-active="en"] .lang-switch__thumb {
      transform: translateX(100%);
    }

    .lang-switch__opt {
      position: relative;
      display: grid;
      place-items: center;
      min-width: 38px;
      padding: 6px 10px;
      font-family: var(--font2);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-indent: 1.5px;
      text-decoration: none;
      color: #ffffff85;
      border-radius: 100px;
      transition: color var(--transition-md);
    }

    .lang-switch__opt[aria-current="true"] {
      color: #fff;
      pointer-events: none;
    }

    @media (hover: hover) {
      .lang-switch:hover {
        border-color: var(--clr-border-hover);
        box-shadow: 0 6px 28px #00000059;
      }

      .lang-switch:hover .lang-switch__icon {
        color: var(--clr-accent);
      }

      .lang-switch__opt:not([aria-current="true"]):hover {
        color: #fff;
      }
    }

    @media (min-width: 750px) {
      .lang-switch {
        top: 24px;
        right: 24px;
      }
    }
  </style>

  <style is:inline>
    section:last-child {
      padding-bottom: 70px;
    }
  </style>
</html>
