---
// Lista de proyectos - solo editas aquí para agregar más
const proyectos = [
  {
    id: 1,
    nombre: "STAURANT",
    descripcion:
      "A gastronomic social platform designed for granular dish-by-dish rating and personalized culinary recommendations.",
    // TODO: URL real del proyecto (antes: https://miportfolio.com — placeholder)
    url: "",
  },
  {
    id: 2,
    nombre: "CERTIYÁ",
    descripcion:
      "An automated digital certification system that eliminates manual processing through instant web-based generation.",
    url: "https://maciainteli.com/certificados/",
  },
  {
    id: 3,
    nombre: "Maintenance Reporting System",
    descripcion:
      "A technical documentation tool designed to automate service reports and track equipment maintenance history.",
    // TODO: URL real (antes apuntaba a /projects/thesimpsons/ — página inexistente)
    url: "",
  },
  {
    id: 4,
    nombre: "Customer Management System",
    descripcion:
      "A self-service customer portal focused on reducing response times through automated information access.",
    // TODO: URL real (antes apuntaba a /projects/thesimpsons/ — página inexistente)
    url: "",
  },
];
---

<section class="proyectos">
  <h2>Pro<span>jects</span></h2>

  <div class="grid">
    {
      proyectos.map((proyecto) => (
        <article class="flex-column card-glass">
          <h3>{proyecto.nombre}</h3>
          <p>{proyecto.descripcion}</p>

          {proyecto.url ? (
            <a
              href={proyecto.url}
              target="_blank"
              rel="noopener noreferrer"
              class="boton"
            >
              View Project
            </a>
          ) : (
            <span class="boton boton-disabled" aria-disabled="true">
              Coming soon
            </span>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  h2 {
    text-align: left;
    width: 100%;
    margin-bottom: 20px;
    /* color: var(--clr-primary); */
  }

  .grid {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    align-items: stretch;
  }

  .card-glass {
    padding: 20px;
    align-items: start;
    gap: 2px;
    width: 100%;
    max-width: 100%;
  }

  .card-glass h3 {
    font-size: 1.3rem;
    padding-left: 0;
    text-indent: 0;
  }

  .card-glass p {
    margin-bottom: 12px;
  }

  .card-glass .boton {
    margin-top: auto;
    border-radius: 15px;
    /* border: solid 1px var(--clr-border); */
  }

  .boton-disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  @media (hover: hover) {
  }

  /* DESKTOP - A partir de 750px */
  @media (min-width: 750px) {
    .grid {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }

    .card-glass {
      max-width: 350px;
    }
  }
</style>
