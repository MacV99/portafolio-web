---
// Contenido en src/i18n/ui.ts — editar allí para agregar proyectos
import {
  useTranslations,
  projects,
  defaultLang,
  type Lang,
} from "../i18n/ui";

const { lang = defaultLang } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
const proyectos = projects[lang];
---

<section class="proyectos">
  <h2>{t("projects.title.a")}<span>{t("projects.title.b")}</span></h2>

  <div class="grid">
    {
      proyectos.map((proyecto) => (
        <article class="flex-column card-glass">
          <h3>{proyecto.nombre}</h3>
          <p>{proyecto.descripcion}</p>

          {proyecto.url ? (
            <a
              href={proyecto.url}
              target="_blank"
              rel="noopener noreferrer"
              class="boton"
            >
              {t("projects.view")}
            </a>
          ) : (
            <span class="boton boton-disabled" aria-disabled="true">
              {t("projects.soon")}
            </span>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  h2 {
    text-align: left;
    width: 100%;
    margin-bottom: 20px;
    /* color: var(--clr-primary); */
  }

  .grid {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    align-items: stretch;
  }

  .card-glass {
    padding: 20px;
    align-items: start;
    gap: 2px;
    width: 100%;
    max-width: 100%;
  }

  .card-glass h3 {
    font-size: 1.3rem;
    padding-left: 0;
    text-indent: 0;
  }

  .card-glass p {
    margin-bottom: 12px;
  }

  .card-glass .boton {
    margin-top: auto;
    border-radius: 15px;
    /* border: solid 1px var(--clr-border); */
  }

  .boton-disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  @media (hover: hover) {
  }

  /* DESKTOP - A partir de 750px */
  @media (min-width: 750px) {
    .grid {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
    }

    .card-glass {
      max-width: 350px;
    }
  }
</style>
